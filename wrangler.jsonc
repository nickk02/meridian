{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  // The SPA build output. The Worker runs first for any path that is not a
  // built asset; for non /api paths the Worker forwards to ASSETS, which
  // returns index.html via single-page-application fallback.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Scheduled ingestion every 15 minutes.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Resource ids are intentionally omitted: `wrangler deploy` (4.45+) creates
  // the D1 database, KV namespace and R2 bucket in the deploying account and
  // binds them. The Vectorize index is the one thing created by hand:
  //   npx wrangler vectorize create meridian-events --dimensions=768 --metric=cosine

  // The ontology database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meridian-db",
      "migrations_dir": "migrations"
    }
  ],

  // Short-TTL feed cache.
  "kv_namespaces": [
    { "binding": "CACHE" }
  ],

  // Raw upstream landing zone (Stage B): cron writes raw feed JSON here, the
  // normalizer reads it back and refines into D1.
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "meridian-raw" }],

  // Semantic correlation (Stage E): event-text embeddings.
  "vectorize": [{ "binding": "VEC", "index_name": "meridian-events" }],

  // Workers AI: bge embeddings for Vectorize and grounded summaries later.
  "ai": { "binding": "AI" },

  // Live global AIS collector: a SQLite-backed Durable Object (free tier) that
  // holds the aisstream.io WebSocket open in bounded alarm windows and stores
  // the latest vessel positions.
  "durable_objects": {
    "bindings": [{ "name": "AIS", "class_name": "AisCollector" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AisCollector"] }]
}
